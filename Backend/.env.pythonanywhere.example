# PythonAnywhere production environment variables
# Set these in: PythonAnywhere -> Web -> your app -> Environment variables

SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# Example: myuser.pythonanywhere.com
ALLOWED_HOSTS=<your-pythonanywhere-username>.pythonanywhere.com

# Frontend domain(s) that can call your backend API
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://<your-pythonanywhere-username>.pythonanywhere.com,https://your-frontend-domain.com

# Optional hardening toggles
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Optional email settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=DailyHabits <noreply@dailyhabits.app>
SUPPORT_EMAIL=support@dailyhabits.app

# Optional: override Celery behavior if you have a broker
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
