# Python Environment Configuration
# This file helps VS Code and other tools find your Python packages

# Virtual Environment Path
PYTHONPATH=${workspaceFolder}/Backend/env/Lib/site-packages

# Django Settings
DJANGO_SETTINGS_MODULE=DailyHabits.settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# Development Settings
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3

# API Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8100

# Logging
LOG_LEVEL=INFO
